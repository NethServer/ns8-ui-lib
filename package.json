{
  "name": "@nethserver/ns8-ui-lib",
  "version": "2.2.0",
  "description": "Vue.js library for NethServer 8 UI",
  "keywords": [
    "nethserver",
    "nethesis",
    "vuejs",
    "vue"
  ],
  "homepage": "https://github.com/NethServer/ns8-ui-lib#readme",
  "bugs": "https://github.com/NethServer/dev/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/NethServer/ns8-ui-lib.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/ns8-ui-lib.ssr.js",
  "browser": "dist/ns8-ui-lib.esm.js",
  "module": "dist/ns8-ui-lib.esm.js",
  "unpkg": "dist/ns8-ui-lib.min.js",
  "files": [
    "dist/*",
    "src/**/*.vue",
    "src/lib-styles/*.scss"
  ],
  "sideEffects": false,
  "scripts": {
    "playground": "vue-cli-service serve",
    "build": "cross-env NODE_ENV=production rollup --config build/rollup.config.js",
    "build:ssr": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format cjs",
    "build:es": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format es",
    "build:unpkg": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format iife",
    "build-pack": "npm version patch --no-git-tag-version && npm run build && npm pack",
    "publish:minor": "npm version minor --allow-same-version -m v%s --force && npm run push-tags",
    "publish:major": "npm version major --allow-same-version -m v%s --force && npm run push-tags",
    "publish:patch": "npm version patch --allow-same-version -m v%s --force && npm run push-tags",
    "push-tags": "git push origin main --tags",
    "npm-publish": "npm publish",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@carbon/icons-vue": "^10.138.0",
    "@carbon/vue": "^2.45.1",
    "@mdx-js/react": "^1.6.22",
    "@rollup/plugin-alias": "^3.1.1",
    "@rollup/plugin-babel": "^5.2.2",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.1",
    "@rollup/plugin-replace": "^2.3.4",
    "@rollup/plugin-terser": "^0.4.0",
    "@storybook/addon-essentials": "~6.5.16",
    "@storybook/addon-links": "~6.5.16",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/vue": "~6.5.16",
    "@vue/cli-plugin-babel": "^4.5.19",
    "@vue/cli-service": "^4.5.19",
    "babel-loader": "^8.4.1",
    "carbon-components": "^10.59.2",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.7",
    "lodash": "4.17.21",
    "lottie-web-vue": "^1.2.1",
    "mark.js": "^8.11.1",
    "minimist": "^1.2.5",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rollup": "^2.53.2",
    "rollup-plugin-vue": "^5.1.9",
    "sass": "^1.105.1",
    "sass-loader": "^10.5.2",
    "style-loader": "^2.0.0",
    "uuid": "3.4.0",
    "vue": "^2.7.16",
    "vue-debounce": "^3.1.1",
    "vue-template-compiler": "^2.7.16",
    "vue2-timepicker": "^1.1.6",
    "vuex": "^3.6.2"
  },
  "peerDependencies": {
    "vue": "^2.6.12"
  },
  "overrides": {
    "vue-loader": "^15.10.0",
    "vue-template-compiler": "^2.7.16"
  },
  "engines": {
    "node": ">=12"
  },
  "dependencies": {
    "@rollup/plugin-json": "^4.1.0",
    "core-js": "^3.15.2",
    "date-fns": "^2.23.0",
    "date-fns-tz": "^1.1.6",
    "vue-date-fns": "^2.0.1"
  },
  "license": "GPL-3.0-or-later"
}
